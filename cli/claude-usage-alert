#!/usr/bin/env python3
"""Reads real plan usage from `claude -p /usage` and notifies via notify-send
when the session / weekly percentage crosses configured thresholds.

Config: ~/.config/claude-usage-alert/config.env
State:  ~/.local/state/claude-usage-alert/state.json
"""
import json
import re
import shutil
import subprocess
import sys
from pathlib import Path

HOME = Path.home()
CONFIG_FILE = HOME / ".config" / "claude-usage-alert" / "config.env"
STATE_DIR = HOME / ".local" / "state" / "claude-usage-alert"
STATE_FILE = STATE_DIR / "state.json"

DEFAULTS = {"SESSION_THRESHOLDS": "70,90", "WEEK_THRESHOLDS": "70,90"}

LINE_RE = {
    "session": re.compile(r"Current session:\s*(\d+)%\s*used(?:\s*·\s*resets\s*(.+))?"),
    "week": re.compile(r"Current week \(all models\):\s*(\d+)%\s*used(?:\s*·\s*resets\s*(.+))?"),
}
LABELS = {"session": "the current session", "week": "the week"}


def load_config():
    cfg = dict(DEFAULTS)
    if CONFIG_FILE.exists():
        for line in CONFIG_FILE.read_text().splitlines():
            line = line.strip()
            if line and not line.startswith("#") and "=" in line:
                k, _, v = line.partition("=")
                cfg[k.strip()] = v.strip().strip("\"'")
    parse = lambda s: sorted(int(x) for x in s.split(",") if x.strip())
    return {"session": parse(cfg["SESSION_THRESHOLDS"]), "week": parse(cfg["WEEK_THRESHOLDS"])}


def fetch_usage():
    claude = shutil.which("claude") or str(HOME / ".local" / "bin" / "claude")
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    out = subprocess.run(
        [claude, "-p", "/usage", "--no-session-persistence"],
        cwd=STATE_DIR, capture_output=True, text=True, timeout=90,
    ).stdout
    result = {}
    for key, rx in LINE_RE.items():
        m = rx.search(out)
        if m:
            result[key] = (int(m.group(1)), (m.group(2) or "").strip())
    return result


def notify(summary, body, urgency):
    subprocess.run(["notify-send", "-u", urgency, "-a", "Claude usage", summary, body], check=False)


def main():
    cfg = load_config()
    usage = fetch_usage()
    if not usage:
        print("could not parse /usage output", file=sys.stderr)
        sys.exit(1)

    if "--test" in sys.argv:
        body = "\n".join(f"{LABELS[k]}: {p}% (resets {r})" for k, (p, r) in usage.items())
        notify("Claude usage: test", body, "normal")
        print(body)
        return

    try:
        state = json.loads(STATE_FILE.read_text())
    except Exception:
        state = {}

    for key, (pct, resets) in usage.items():
        entry = state.get(key, {})
        if entry.get("resets") != resets:
            entry = {"resets": resets, "notified": []}
        for th in cfg[key]:
            if pct >= th and th not in entry["notified"]:
                notify(
                    f"Claude Code: {th}% of the limit for {LABELS[key]}",
                    f"Used {pct}%. Resets: {resets}",
                    "critical" if th >= 90 else "normal",
                )
                entry["notified"].append(th)
        state[key] = entry
        state[key]["pct"] = pct

    STATE_FILE.write_text(json.dumps(state, ensure_ascii=False))


if __name__ == "__main__":
    main()
